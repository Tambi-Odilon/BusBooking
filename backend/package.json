{
  "name": "bus-booking-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de réservation de billets de bus (marque blanche)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsc -p tsconfig.build.json --watch & node --watch dist/main.js",
    "migrate": "node dist/migrate.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --runInBand",
    "test:unit": "npm test -- test/unit",
    "test:integration": "npm test -- test/integration",
    "test:concurrency": "npm test -- test/concurrency",
    "test:load": "bash test/load/run.sh"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/platform-socket.io": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/websockets": "^11.2.9",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "jest": "^29.7.0",
    "smtp-server": "^3.21.4",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.15",
    "typescript": "5.8"
  }
}
