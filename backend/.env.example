# Développement local du backend (copier en .env n'est pas nécessaire : ces valeurs sont les défauts hors production).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/bb_dev
REDIS_URL=redis://127.0.0.1:6379
PUBLIC_URL=http://localhost:4200
# En production, ces trois secrets sont obligatoires (32 caractères au moins) :
# JWT_SECRET=
# APP_ENCRYPTION_KEY=
# WEBHOOK_SECRET=
