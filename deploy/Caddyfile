# Reverse proxy HTTPS + fichiers du site.
# DOMAIN = nom de domaine public (certificat Let's Encrypt automatique).
#   - "localhost"  : certificat local auto-signé, pour un essai sur son poste
#   - ":80"        : HTTP simple, à utiliser seulement derrière un autre proxy qui fait déjà le HTTPS
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Les métriques ne sont jamais exposées sur Internet (lecture depuis le réseau Docker uniquement).
	handle /metrics {
		respond 404
	}

	# API REST, temps réel et contrôles de santé
	@api path /api/* /socket.io/* /health/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Real-IP {remote_host}
		}
	}

	# Site (fichiers Angular)
	handle {
		root * {$WEB_ROOT:/srv}
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Fichiers au nom haché : cache d'un an. Le reste (index.html) : toujours revalidé.
		@hashed path_regexp hashed -[A-Z0-9]{8}\.(js|css|woff2?|ttf|png|jpe?g|webp|svg)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@nothashed not path_regexp -[A-Z0-9]{8}\.(js|css|woff2?|ttf|png|jpe?g|webp|svg)$
		header @nothashed Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
