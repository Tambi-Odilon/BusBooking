# ─────────────────────────────────────────────────────────────────────────────
#  Configuration de l'installation. Copier ce fichier en ".env" puis l'adapter.
#  Le script scripts/install.sh le fait pour vous et génère les secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Nom de domaine public du site (un enregistrement DNS A doit pointer vers ce serveur).
# "localhost" pour un essai sur son poste (certificat auto-signé).
DOMAIN=reservation.exemple.com

# Adresse publique complète. Doit correspondre à DOMAIN (https:// en production).
PUBLIC_URL=https://reservation.exemple.com

# Version affichée dans /health/live et dans Paramètres → Système.
APP_VERSION=1.0.0

# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_DB=busbooking
POSTGRES_USER=busbooking
# Lettres et chiffres uniquement (la valeur est insérée dans une URL).
POSTGRES_PASSWORD=CHANGER_MOI

# ── Redis ───────────────────────────────────────────────────────────────────
# Lettres et chiffres uniquement.
REDIS_PASSWORD=CHANGER_MOI

# ── Secrets de l'application (32 caractères au moins, générés à l'installation) ──
# Signature des jetons de connexion.
JWT_SECRET=CHANGER_MOI
# Clé maîtresse qui chiffre les clés de paiement et le mot de passe SMTP en base.
# ⚠ À conserver précieusement : sans elle, ces secrets sont illisibles après une restauration.
APP_ENCRYPTION_KEY=CHANGER_MOI
# Signature des adresses de callback des opérateurs de paiement.
WEBHOOK_SECRET=CHANGER_MOI

# Code demandé à l'ouverture de l'assistant de première configuration.
# Empêche un inconnu de configurer l'application avant vous. Vide = pas de code.
SETUP_TOKEN=CHANGER_MOI

# Jeton pour lire /metrics (Prometheus) depuis le réseau interne. Vide = métriques désactivées.
METRICS_TOKEN=

# ── Réglages avancés (les valeurs par défaut conviennent à la plupart des cas) ──
# Connexions PostgreSQL par processus (API et worker).
DB_POOL_MAX=20
# info | warn | error | debug
LOG_LEVEL=info
# true uniquement si votre serveur SMTP utilise un certificat auto-signé.
SMTP_ALLOW_SELF_SIGNED=false
# Mettre false seulement si le site est servi en HTTP simple (essai local avec DOMAIN=:80).
COOKIE_SECURE=true

# ── Sauvegardes ─────────────────────────────────────────────────────────────
# Dossier du serveur qui reçoit les sauvegardes (à copier régulièrement hors du serveur).
BACKUP_DIR=./backups
# Heure de la sauvegarde quotidienne (0-23, heure du fuseau ci-dessous).
BACKUP_HOUR=2
TZ=Indian/Antananarivo
# Phrase secrète pour chiffrer les sauvegardes (AES-256). Vide = sauvegardes non chiffrées.
BACKUP_PASSPHRASE=
# Durées de conservation, en jours.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=35
BACKUP_KEEP_MONTHLY=190
